[Unit]
Description=Sentinelle Aérienne - module IA embarqué
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinelle
WorkingDirectory=/opt/sentinelle/ia
EnvironmentFile=-/etc/sentinelle/env
ExecStart=/opt/sentinelle/ia/.venv/bin/python -m sentinelle_ia --config configs/sentinelle.yaml
Restart=on-failure
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
